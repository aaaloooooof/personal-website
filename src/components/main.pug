.content.content-main
  #card
    canvas.grid-background#gridCanvas
    .card-inner.fade
      .pm-home
        header.pm-minimal-header
          img(src=`${main.avatar.link}` width=`${main.avatar.width}` height=`${main.avatar.height}` alt="avatar")
          h1(data-translate="name") #{main.name}
          h2#signature(data-translate="signature" original-content=`${main.signature}`) #{main.signature}

        p.pm-keywords
          span story
          span.dot •
          span map
          span.dot •
          span compass

        nav.pm-nav-links(aria-label="主页导航")
          a.pm-nav-item(href="resume.html")
            span.pm-nav-icon
              svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                path(d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z")
                path(d="M14 2v5h5")
                path(d="M9 13h6")
                path(d="M9 17h6")
            span 简历与经历
          a.pm-nav-item(href="projects.html")
            span.pm-nav-icon
              svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                rect(x="3" y="3" width="7" height="7" rx="1.5")
                rect(x="14" y="3" width="7" height="7" rx="1.5")
                rect(x="3" y="14" width="7" height="7" rx="1.5")
                rect(x="14" y="14" width="7" height="7" rx="1.5")
            span 项目
          a.pm-nav-item(href="weekly.html")
            span.pm-nav-icon
              svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                path(d="M8 2v4")
                path(d="M16 2v4")
                rect(x="3" y="4" width="18" height="18" rx="2")
                path(d="M3 10h18")
                path(d="M8 14h3")
                path(d="M8 18h6")
            span 周报
          a.pm-nav-item(href="contact.html")
            span.pm-nav-icon
              svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                path(d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z")
                path(d="m22 7-10 6L2 7")
            span 联系信息
